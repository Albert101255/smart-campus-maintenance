# Spring Profile: leave unset for H2 in-memory mode, or set to 'mysql' for MySQL 8
SPRING_PROFILES_ACTIVE=mysql

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration (used when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_campus_db
DB_USERNAME=root
DB_PASSWORD=rootpassword
